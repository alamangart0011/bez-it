# Токен бота (создаётся у @BotFather)
BEZIT_TG_BOT_TOKEN=

# URL API лидов bez-it.ru (куда складываем заявки)
BEZIT_API_URL=https://bez-it.ru/api/bez-it/leads

# ID канала или чата для копий заявок (опционально)
BEZIT_TG_IP_CHAT=

# Режим long-polling или webhook
BEZIT_BOT_MODE=polling
BEZIT_BOT_WEBHOOK_URL=
BEZIT_BOT_PORT=3010
