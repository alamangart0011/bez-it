POSTGRES_DB=corpchat
POSTGRES_USER=corpchat
POSTGRES_PASSWORD=change_me_now
POSTGRES_HOST=db
POSTGRES_PORT=5432

API_PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://ai.voice.oboron-it.ru
TRUST_PROXY=1
JWT_SECRET=super_secret_change_me
JWT_REFRESH_SECRET=super_refresh_secret_change_me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

MAX_UPLOAD_BYTES=26214400
UPLOAD_ROOT=/app/uploads
SOCKET_PATH=/socket.io
APP_REGION=RU
APP_COUNTRY_MODE=RUSSIA_ONLY
RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=20

# Для production voice/screen-share лучше указывать локальный Coturn внутри вашего контура.
RTC_ICE_SERVERS_JSON=
RTC_STUN_URLS=
RTC_TURN_URLS=turn:turn.internal.local:3478?transport=udp,turns:turn.internal.local:5349?transport=tcp
RTC_TURN_USERNAME=kontur
RTC_TURN_CREDENTIAL=change_me

APP_NAME=Контур Связи
RELEASE_VERSION=17.17.0
RELEASE_CHANNEL=operator-wallboard
HEALTH_EXTERNAL_URL=https://ai.voice.oboron-it.ru/api/health
REQUEST_LOG_ENABLED=true

# ──────────────────────────────────────────────────────────────────
# bez-it.ru — лидогенерация для ИП Сапрыкина Е.В.
# Маршрутизация заявок в Telegram партнёров (НПК Оборон-Экран и Cent-IT)
# ──────────────────────────────────────────────────────────────────
# Токен телеграм-бота (создайте в @BotFather)
BEZIT_TG_BOT_TOKEN=
# ID чата/канала Оборон-Экран (ИБ, КИИ, СКЗИ, гос)
BEZIT_TG_OBORON_CHAT=
# ID чата/канала Cent-IT (СКУД, видеонаблюдение, аутсорсинг, 1С)
BEZIT_TG_CENT_CHAT=
# ID личного чата ИП Сапрыкина (копия каждой заявки)
BEZIT_TG_IP_CHAT=
# Опциональный webhook для внешней CRM (Bitrix24/amoCRM)
BEZIT_WEBHOOK_URL=
# Токен для кабинета ИП (hash от него автоматически пишется в bez_it_cabinet_tokens)
BEZIT_CABINET_TOKEN=
# Rate-limit — публичная форма заявок (в минуту с IP)
BEZIT_PUBLIC_RATE_LIMIT=30
# Rate-limit — кабинет ИП
BEZIT_CABINET_RATE_LIMIT=120
