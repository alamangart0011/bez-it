# Песочница bez-it.ru — копия в .env, и поднимаете compose
# ---------------------------------------------------------

# БД
BEZIT_DB_NAME=bezit
BEZIT_DB_USER=bezit
BEZIT_DB_PASSWORD=bezit_change_me

# Внешний порт песочницы (откроется на http://<ip-сервера>:8088/)
BEZIT_HTTP_PORT=8088

# Telegram (если хотите проверить отправку лидов)
BEZIT_TG_BOT_TOKEN=
BEZIT_TG_OBORON_CHAT=
BEZIT_TG_CENT_CHAT=
BEZIT_TG_IP_CHAT=
BEZIT_WEBHOOK_URL=

# Кабинет ИП — токен для входа (Bearer)
BEZIT_CABINET_TOKEN=devtoken_change_me

# Лимит обращений к публичному API лидов на IP в минуту
BEZIT_RATE_LIMIT_PER_IP_MIN=30

# Режим Telegram-бота: polling или webhook (профиль "bot")
BEZIT_BOT_MODE=polling

# JWT-секреты для backend V17 (auto-generate в bootstrap)
BEZIT_JWT_SECRET=change_me_random_64_hex
BEZIT_JWT_REFRESH_SECRET=change_me_random_64_hex
